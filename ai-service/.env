# 服务配置
HOST=0.0.0.0
PORT=8000
DEBUG=true

# OpenAI API配置 (可选，用于调用GPT模型)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4

# 本地模型配置 (可选，用于本地模型推理)
LOCAL_MODEL_PATH=/path/to/local/model
LOCAL_MODEL_TYPE=codellama

# Redis配置 (用于缓存)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=

# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=json

# 代码解析配置
MAX_CODE_LENGTH=50000
SUPPORTED_LANGUAGES=python,javascript,typescript,java,go,cpp

# AI处理配置
MAX_PROMPT_LENGTH=8000
AI_TIMEOUT=30
MAX_RETRY=3